+def _compute_frechet_selection(
+    *,
+    confidence: torch.Tensor,
+    mask_index: torch.Tensor,
+    margin: float,
+) -> torch.Tensor:
+    """Frechet-profile commit rule (INSERTION experiment).
+
+    Ported VERBATIM from the anchor ``get_transfer_index_frechet_profile``
+    (Fast-dLLM/v1/llada/generate.py): for sorted masked-candidate
+    confidences c_(1) >= ... >= c_(n),
+        L_n = sum_{j<=n} c_(j) - (n - 1)
+        U_n = 1 - c_(n)
+        score_n = L_n - U_n
+    commit the largest set with score_n > margin (always >= 1 token when
+    masks remain). Operates on the SAME per-step marginal confidences that
+    DAPD's own selector consumes; equal-confidence case reduces to Factor
+    f = 1 - margin.
+    """
+    conf = confidence.to(torch.float64)
+    neg_inf = torch.tensor(torch.finfo(conf.dtype).min, device=conf.device, dtype=conf.dtype)
+    conf = torch.where(mask_index, conf, neg_inf)
+
+    B, L = conf.shape
+    values, idx = torch.sort(conf, dim=1, descending=True)
+
+    counts = mask_index.sum(dim=1)  # (B,)
+    cols = torch.arange(L, device=conf.device).unsqueeze(0).expand(B, L)
+    valid = cols < counts.unsqueeze(1)
+
+    sorted_conf = torch.where(valid, values, torch.zeros_like(values))
+    cum = torch.cumsum(sorted_conf, dim=1)
+
+    # n is 1-indexed: L_n = cum_n - (n-1) = cum - cols  (cols is 0-indexed)
+    frechet_lb = cum - cols.to(cum.dtype)
+    competitor_ub = 1.0 - values
+    score = frechet_lb - competitor_ub
+
+    score = torch.where(valid, score, torch.full_like(score, -torch.inf))
+
+    # always transfer at least one token whenever masked tokens exist
+    score[:, 0] = torch.inf
+
+    choose = score > margin
+    topn = choose.sum(dim=1).clamp(min=1)
+
+    select_sorted = cols < topn.unsqueeze(1)
+    transfer_int = torch.zeros(B, L, device=conf.device, dtype=torch.int8)
+    transfer_int = transfer_int.scatter(1, idx, select_sorted.to(torch.int8))
+    return transfer_int.bool() & mask_index
 
 
