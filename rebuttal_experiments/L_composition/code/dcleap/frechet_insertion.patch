+def verify_and_commit_frechet(
+    region_logits: torch.Tensor,
+    region_x: torch.Tensor,
+    mask_id: int,
+    frechet_margin: float,
+    left_boundary_known: bool
+):
+    """
+    Frechet-certificate replacement for DC-Leap's per-token commit threshold
+    (INSERTION experiment). Ported VERBATIM from
+    ~/anchors/generate.py::get_transfer_index_frechet_profile:
+
+        For selected confidences c_(1) >= ... >= c_(n):
+            L_n   = sum_{j=1}^n c_(j) - (n - 1)     (frechet_lb)
+            U_n   = 1 - c_(n)                        (competitor_ub)
+            score = L_n - U_n
+        Commit the largest n with score_n > frechet_margin.
+
+    The ONLY difference vs the anchor reference: the candidate set is DC-Leap's
+    contiguous masked prefix of the decoding window (position order), preserving
+    DC-Leap's Dynamic Contiguous Verification workflow. Within a positional
+    prefix, c_(n) = running min of the prefix, so the same L_n/U_n formulas
+    apply set-wise (the certificate holds for ANY proposed commit set).
+    Equal-confidence case reduces to Factor f = 1 - delta, as in the reference.
+    Everything else (drafting, window scheduling, fallback) is unchanged.
+    """
+    top1_indices, top1_probs = get_top1_info(region_logits)
+
+    is_mask = (region_x == mask_id)
+
+    if not left_boundary_known:
+        final_commit_mask = torch.zeros_like(is_mask, dtype=torch.bool)
+        return top1_indices, final_commit_mask
+
+    # confidences in float64, as in the reference implementation
+    c = top1_probs.to(torch.float64)
+    L = c.shape[0]
+    cols = torch.arange(L, device=c.device, dtype=torch.float64)  # 0-indexed (n-1)
+
+    # candidate prefix must stay within the contiguous masked prefix
+    valid = torch.cumprod(is_mask.int(), dim=0).bool()
+
+    cum = torch.cumsum(torch.where(valid, c, torch.zeros_like(c)), dim=0)
+    run_min = torch.cummin(torch.where(valid, c, torch.ones_like(c)), dim=0).values
+
+    # n is 1-indexed: L_n = cum_n - (n-1) = cum - cols (cols is 0-indexed)
+    frechet_lb = cum - cols
+    competitor_ub = 1.0 - run_min
+    score = frechet_lb - competitor_ub
+
+    score = torch.where(valid, score, torch.full_like(score, -torch.inf))
+
+    choose = score > frechet_margin
+    topn = int(choose.sum().item())
+
+    final_commit_mask = torch.zeros_like(is_mask, dtype=torch.bool)
+    if topn > 0:
+        final_commit_mask[:topn] = True
+    final_commit_mask = final_commit_mask & is_mask
+
+    return top1_indices, final_commit_mask
+
+# Instrumentation only (INSERTION experiment): counts model forward passes
+# (1 per decoding-window iteration; x2 when cfg_scale>0 doubles the batch).
+# Does not alter generation behavior.
+NFE_COUNTER = {"count": 0}
+
+
